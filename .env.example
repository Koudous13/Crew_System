GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_TEMPERATURE=0.3
GEMINI_TIMEOUT_SECONDS=240
GEMINI_STEP_TIMEOUT_SECONDS=28
GEMINI_CHAT_TIMEOUT_SECONDS=15
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_MAX_RETRIES=3
GEMINI_RESPONSE_SCHEMA=false

# Cloud deployment with Vercel + Supabase.
# Keep SUPABASE_SERVICE_ROLE_KEY server-side only. Never expose it in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. DeepSeek is explicit-only: use --provider deepseek when it is healthy.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_TEMPERATURE=0.3
# DEEPSEEK_TIMEOUT_SECONDS=240
# DEEPSEEK_MAX_RETRIES=6
